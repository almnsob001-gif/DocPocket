[app]
title = MediCalc
package.name = medcalc
package.domain = org.medcalc
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0.0
requirements = python3,kivy==2.1.0,kivymd==1.1.1,plyer
orientation = portrait
fullscreen = 0
android.api = 30
android.minapi = 21
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
